<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Studio Member Shop</title>
    <link rel="stylesheet" href="/static/app.css">
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="#shop">
        <span class="brand-mark">S</span>
        <span>
          <strong>Studio Member Shop</strong>
          <small>會員制工作室商店</small>
        </span>
      </a>
      <nav>
        <button data-view="shop">商店</button>
        <button data-view="orders" class="auth-only">我的訂單</button>
        <button data-view="admin" class="admin-only">管理後台</button>
      </nav>
      <div class="account">
        <span id="userBadge"></span>
        <button id="logoutBtn" class="auth-only ghost">登出</button>
        <button data-view="auth" class="guest-only">登入 / 申請</button>
      </div>
    </header>

    <main>
      <section id="notice" class="notice hidden"></section>

      <section id="shopView" class="view active">
        <div class="hero">
          <div class="hero-copy">
            <p class="eyebrow">Curated studio goods</p>
            <h1>只給審核會員進入的工作室選物與課程商店</h1>
            <p>從限量作品、工作坊套組到會員收藏品，所有商品都由後台上架並儲存在 SQLite 資料庫。</p>
          </div>
          <div class="hero-panel">
            <span>會員審核</span>
            <strong id="heroStatus">登入後可下單</strong>
            <small>管理員可以核准會員、管理商品、追蹤訂單狀態。</small>
          </div>
        </div>

        <div class="section-title">
          <div>
            <p class="eyebrow">Shop</p>
            <h2>商品列表</h2>
          </div>
          <button id="openCartBtn" class="primary">購物車 <span id="cartCount">0</span></button>
        </div>
        <div id="productsGrid" class="product-grid"></div>
      </section>

      <section id="authView" class="view">
        <div class="auth-grid">
          <form id="loginForm" class="panel">
            <p class="eyebrow">Admin or member</p>
            <h2>登入</h2>
            <label>帳號或 Email<input name="username" autocomplete="username" required></label>
            <label>密碼<input name="password" type="password" autocomplete="current-password" required></label>
            <button class="primary">登入</button>
          </form>
          <form id="registerForm" class="panel">
            <p class="eyebrow">Membership</p>
            <h2>申請會員</h2>
            <label>帳號<input name="username" minlength="3" required></label>
            <label>Email<input name="email" type="email" required></label>
            <label>密碼<input name="password" type="password" minlength="6" required></label>
            <button class="primary">送出審核</button>
            <p class="hint">新帳號會是 pending，需管理員核准後才能下單。</p>
          </form>
        </div>
      </section>

      <section id="ordersView" class="view">
        <div class="section-title">
          <div>
            <p class="eyebrow">Orders</p>
            <h2>訂單紀錄</h2>
          </div>
        </div>
        <div id="ordersList" class="stack"></div>
      </section>

      <section id="adminView" class="view">
        <div class="section-title">
          <div>
            <p class="eyebrow">Back office</p>
            <h2>管理後台</h2>
          </div>
        </div>
        <div class="admin-layout">
          <form id="productForm" class="panel">
            <input type="hidden" name="id">
            <p class="eyebrow">Product</p>
            <h2 id="productFormTitle">新建商品</h2>
            <label>商品名稱<input name="name" required></label>
            <label>分類<input name="category" value="Studio Goods"></label>
            <label>價格<input name="price" type="number" min="0" required></label>
            <label>庫存<input name="stock" type="number" min="0" required></label>
            <label>圖片網址<input name="image_url" placeholder="https://..."></label>
            <label>商品描述<textarea name="description" rows="4"></textarea></label>
            <div class="row">
              <label>狀態
                <select name="status">
                  <option value="draft">草稿</option>
                  <option value="active">上架</option>
                  <option value="archived">封存</option>
                </select>
              </label>
              <label class="check"><input type="checkbox" name="featured"> 精選</label>
            </div>
            <div class="actions">
              <button class="primary">儲存商品</button>
              <button type="button" id="resetProductBtn" class="ghost">清空</button>
            </div>
          </form>

          <div class="stack">
            <div class="panel">
              <p class="eyebrow">Members</p>
              <h2>會員審核</h2>
              <div id="usersTable" class="table"></div>
            </div>
            <div class="panel">
              <p class="eyebrow">Products</p>
              <h2>商品管理</h2>
              <div id="adminProducts" class="table"></div>
            </div>
            <div class="panel">
              <p class="eyebrow">Fulfillment</p>
              <h2>訂單管理</h2>
              <div id="adminOrders" class="table"></div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <aside id="cartDrawer" class="drawer" aria-hidden="true">
      <div class="drawer-panel">
        <div class="drawer-head">
          <h2>購物車</h2>
          <button id="closeCartBtn" class="ghost">關閉</button>
        </div>
        <div id="cartItems" class="stack"></div>
        <form id="checkoutForm">
          <label>收件人<input name="customer_name" required></label>
          <label>電話<input name="phone" required></label>
          <label>地址<input name="address" required></label>
          <label>備註<textarea name="note" rows="3"></textarea></label>
          <div class="total">合計 <strong id="cartTotal">$0</strong></div>
          <button class="primary">送出訂單</button>
        </form>
      </div>
    </aside>

    <script src="/static/app.js"></script>
  </body>
</html>
